<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ApplicationIcon>appicon.ico</ApplicationIcon>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.1.6" />
		<PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="NLog" Version="6.2.2" />
		<PackageReference Include="Octokit" Version="14.0.0" />
		<PackageReference Include="SharpZipLib" Version="1.4.2" />
		<PackageReference Include="Tmds.DBus.Protocol" Version="0.95.2" />
		<PackageReference Include="Tmds.DBus.Generator" Version="0.95.2" PrivateAssets="all" />
	</ItemGroup>
	<ItemGroup>
	  <ProjectReference Include="..\lively.Common\lively.Common.csproj" />
	  <ProjectReference Include="..\lively.Core\lively.Core.csproj" />
	  <ProjectReference Include="..\lively.Ipc\lively.Ipc.csproj" />
	  <ProjectReference Include="..\lively.Models\lively.Models.csproj" />
	  <!-- Copy lively-daemon, lively-player-dummy and lively-player-mpv next to the UI, which starts the daemon. -->
	  <ProjectReference Include="..\lively.Daemon\lively.Daemon.csproj" />
	  <ProjectReference Include="..\lively.Player.Dummy\lively.Player.Dummy.csproj" />
	  <ProjectReference Include="..\lively.Player.Mpv\lively.Player.Mpv.csproj" />
	</ItemGroup>
	<ItemGroup>
	  <AdditionalFiles Include="..\lively.Ipc\dbus-xml\org.freedesktop.Application.xml" Link="DBus\org.freedesktop.Application.xml" DBusGeneratorMode="Handler" Namespace="lively.DBus" Visibility="internal" />
	</ItemGroup>
</Project>
