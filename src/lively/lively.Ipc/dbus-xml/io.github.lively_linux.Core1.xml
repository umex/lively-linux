<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <!--
    Core of lively-linux, owned by lively-daemon as io.github.lively_linux.Daemon
    at /io/github/lively_linux/Core. Errors: io.github.lively_linux.Error.{WallpaperNotFound,
    DisplayNotFound, PlayerFailed, InvalidSettings, ImportFailed, Failed}. See docs/ipc.md.
  -->
  <interface name="io.github.lively_linux.Core1">
    <!-- (id, description, (x, y, width, height), scale, primary) -->
    <method name="GetDisplays">
      <arg name="displays" type="a(ss(iiii)db)" direction="out"/>
    </method>
    <!-- (display id, wallpaper folder) of running wallpapers -->
    <method name="GetWallpapers">
      <arg name="wallpapers" type="a(ss)" direction="out"/>
    </method>
    <!-- display "" = primary. Returns after the player reports msg_wploaded, or errors. -->
    <method name="SetWallpaper">
      <arg name="folder" type="s" direction="in"/>
      <arg name="display" type="s" direction="in"/>
    </method>
    <method name="CloseWallpaper">
      <arg name="display" type="s" direction="in"/>
    </method>
    <method name="CloseAllWallpapers"/>
    <!-- settings as JSON -->
    <method name="GetSettings">
      <arg name="settings" type="s" direction="out"/>
    </method>
    <method name="SetSettings">
      <arg name="settings" type="s" direction="in"/>
    </method>
    <!-- pauses or resumes every wallpaper; wallpapers started later follow -->
    <method name="SetPaused">
      <arg name="paused" type="b" direction="in"/>
    </method>
    <method name="GetPaused">
      <arg name="paused" type="b" direction="out"/>
    </method>
    <!-- copies a video file (absolute path) into the library; returns the new wallpaper folder -->
    <method name="ImportVideo">
      <arg name="path" type="s" direction="in"/>
      <arg name="folder" type="s" direction="out"/>
    </method>
    <method name="Quit"/>
    <!-- folder "" = closed -->
    <signal name="WallpaperChanged">
      <arg name="display" type="s"/>
      <arg name="folder" type="s"/>
    </signal>
    <signal name="DisplaysChanged"/>
    <signal name="Error">
      <arg name="display" type="s"/>
      <arg name="message" type="s"/>
    </signal>
    <!-- sent only when the value changes -->
    <signal name="PausedChanged">
      <arg name="paused" type="b"/>
    </signal>
  </interface>
</node>
