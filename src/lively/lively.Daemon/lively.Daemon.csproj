<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>lively-daemon</AssemblyName>
    <RootNamespace>lively.Daemon</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
    <PackageReference Include="NLog.Extensions.Logging" Version="6.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\lively.Core\lively.Core.csproj" />
    <!-- Copies lively-player-dummy next to lively-daemon. -->
    <ProjectReference Include="..\lively.Player.Dummy\lively.Player.Dummy.csproj" />
    <!-- Copies lively-player-mpv next to lively-daemon. -->
    <ProjectReference Include="..\lively.Player.Mpv\lively.Player.Mpv.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Templates and icon for the install-user option (UserInstaller); also copied into referencing projects. -->
    <None Include="data\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
